{
  "name": "jsonld-from-schema",
  "version": "0.1.0",
  "description": "Clean-room JSON Schema (2020-12 / draft-07) -> JSON-LD 1.1 context, RDFS/OWL + SHACL, and instance annotation",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "jsonld-from-schema": "bin/jsonld-from-schema.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:spec": "node --test test/spec.test.js",
    "proof:broken": "node test/run-broken.mjs",
    "audit:licenses": "node tools/license-audit.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsonld": "^9.0.0",
    "n3": "^2.13.12",
    "yaml": "^2.9.1"
  }
}
