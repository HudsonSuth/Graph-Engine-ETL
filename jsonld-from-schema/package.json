{
  "name": "jsonld-from-schema",
  "version": "0.1.0",
  "description": "Clean-room JSON Schema → JSON-LD 1.1 converter (static)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jsonld-from-schema": "./bin/jsonld-from-schema.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "SPEC.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:broken": "JSONLD_FROM_SCHEMA_IMPL=broken vitest run > test/broken-run.txt 2>&1; test $? -ne 0",
    "cli": "node --import tsx bin/jsonld-from-schema.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsonld": "^8.3.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/jsonld": "^1.5.15",
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  },
  "license": "Apache-2.0"
}
