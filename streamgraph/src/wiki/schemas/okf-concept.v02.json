{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://streamgraph.local/schemas/wiki/okf-concept.v02.json",
  "title": "OKF v0.2 concept frontmatter (trust families) as StreamGraph reads it",
  "type": "object",
  "required": ["type"],
  "properties": {
    "type": { "anyOf": [ { "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } } ] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "status": { "enum": ["draft", "stable", "deprecated"] },
    "stale_after": { "type": "string", "format": "date-time" },
    "generated": { "$ref": "#/definitions/stamp" },
    "verified": { "type": "array", "items": { "$ref": "#/definitions/stamp" } },
    "sources": { "type": "array", "items": { "anyOf": [ { "type": "string", "minLength": 1 }, { "type": "object", "anyOf": [ { "required": ["resource"] }, { "required": ["url"] }, { "required": ["path"] } ] } ] } }
  },
  "definitions": {
    "stamp": { "type": "object", "required": ["by"], "properties": { "by": { "type": "string", "pattern": "^[^\\s]+$" }, "at": { "type": "string", "format": "date-time" }, "note": { "type": "string" } } }
  }
}
