{
  "version": 1,
  "events": {
    "node.upsert": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "$id": "https://streamgraph.local/schemas/explore/node.upsert/v1.json",
      "title": "Node upsert event",
      "type": "object",
      "required": [
        "schemaVersion",
        "eventId",
        "op",
        "sourceId",
        "seq",
        "eventTime",
        "payload"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "eventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "op": {
          "const": "node.upsert"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "partition": {
          "type": [
            "integer",
            "string"
          ]
        },
        "eventTime": {
          "type": "string",
          "format": "date-time"
        },
        "ingestTime": {
          "type": "string",
          "format": "date-time"
        },
        "partial": {
          "type": "boolean"
        },
        "payload": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "label": {
              "type": "string",
              "maxLength": 1024
            },
            "properties": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "pattern": "^sys:"
                }
              }
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sourceId"
                ],
                "properties": {
                  "sourceId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "nativeId": {
                    "type": "string"
                  },
                  "fetchedAt": {
                    "type": "string"
                  }
                }
              }
            },
            "eventTime": {
              "type": "string",
              "format": "date-time"
            },
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "kind": {
              "const": "node"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "partial": {
            "const": true
          }
        },
        "required": [
          "partial"
        ]
      },
      "then": {},
      "else": {
        "properties": {
          "payload": {
            "required": [
              "type"
            ]
          }
        }
      }
    },
