      "id": {
        "type": "string"
      },
      "deleted": {
        "type": "boolean"
      },
      "event": {
        "type": "object"
      },
      "change": {
        "type": "object",
        "required": [
          "eventId"
        ],
        "properties": {
          "eventId": {
            "type": "string"
          },
          "producedAt": {
            "type": "integer"
          }
        }
      },
      "sourceId": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
