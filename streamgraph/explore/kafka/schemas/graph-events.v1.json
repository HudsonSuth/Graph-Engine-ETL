  "command": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://streamgraph.local/schemas/explore/command/v1.json",
    "title": "Graph command (orchestrator -> worker)",
    "type": "object",
    "required": [
      "schemaVersion",
      "commandId",
      "kind",
      "issuedAt",
      "issuer",
      "args"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "commandId": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_.:-]{8,128}$"
      },
      "kind": {
        "enum": [
          "upsert_node",
          "upsert_link",
          "remove_item"
        ]
      },
      "issuedAt": {
        "type": "string",
        "format": "date-time"
      },
      "issuer": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "via": {
            "type": "string"
          }
        }
      },
      "args": {
        "type": "object"
      }
    },
    "additionalProperties": false
  },
  "commandResult": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://streamgraph.local/schemas/explore/command-result/v1.json",
    "title": "Command result",
    "type": "object",
    "required": [
      "schemaVersion",
      "commandId",
      "status",
      "at"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "commandId": {
        "type": "string"
      },
      "status": {
        "enum": [
          "applied",
          "rejected"
        ]
      },
      "reason": {
        "type": "string"
      },
      "eventIds": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "at": {
        "type": "string",
        "format": "date-time"
      },
      "worker": {
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "stateRecord": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://streamgraph.local/schemas/explore/state-record/v1.json",
